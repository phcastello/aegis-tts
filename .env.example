# Copy to .env before starting.  Do not commit the resulting .env file.

# Published HTTP endpoint.  It is intentionally bound to all host interfaces;
# use scripts/configure-firewall.sh to restrict access to 10.1.1.0/24.
AEGIS_TTS_BIND_ADDRESS=0.0.0.0
AEGIS_TTS_PORT=8001
AEGIS_TTS_INTERNAL_PORT=8001

# These defaults match the current host user.  On a different host, set them
# with: printf 'AEGIS_TTS_UID=%s\nAEGIS_TTS_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
AEGIS_TTS_UID=1002
AEGIS_TTS_GID=1002

# Leave empty to keep LAN synthesis unauthenticated.  If non-empty, POST
# /v1/synthesize requires the X-API-Key header.  Never place this value in Git.
AEGIS_TTS_API_KEY=

# Optional Hugging Face access token for the explicit download command only.
# It is not needed for public model files and is never logged by the scripts.
HF_TOKEN=

QWEN_DTYPE=bfloat16
AEGIS_TTS_MAX_TEXT_LENGTH=1000
AEGIS_TTS_QUEUE_TIMEOUT_SECONDS=240
AEGIS_TTS_GENERATION_TIMEOUT_SECONDS=180
AEGIS_TTS_SAVE_SAMPLES=false
AEGIS_TTS_MAX_SAMPLES=100
# Empty keeps the normal dynamic KV cache.  Test `static` only through the
# dedicated static-cache Compose image documented in the README.
AEGIS_TTS_CACHE_IMPLEMENTATION=
AEGIS_TTS_LOG_LEVEL=INFO

# Never use *.  Same-origin UI needs no CORS entry; add only known LAN origins
# if a separate browser client needs it.
AEGIS_TTS_ALLOWED_ORIGINS=http://10.1.1.47:8001,http://localhost:8001
